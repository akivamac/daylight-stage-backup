@charset "utf-8";

:root { --bg: #f6f3ec; --panel: #ffffff; --panel-2: #efece2; --line: #d8d4c8; --text: #1a1a1f; --muted: #6b6b75; --pink: #e91e63; --cyan: #00acc1; --lime: #8bc34a; --amber: #f57c00; }

* { box-sizing: border-box; }

html, body { margin: 0px; padding: 0px; height: 100%; background: var(--bg); color: var(--text); font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif; overflow: hidden; text-size-adjust: 100%; }

#app { display: flex; flex-direction: row-reverse; height: 100dvh; }

#blocklyArea { flex: 1.2 1 0%; min-width: 280px; background: var(--panel); position: relative; }

#blocklyDiv { position: absolute; inset: 0px; }

#rightPanel { flex: 1 1 0%; min-width: 320px; display: flex; flex-direction: column; border-right: 1px solid var(--line); background: var(--panel); }

header.bar { display: flex; align-items: center; gap: 10px; padding: 4px 8px; background: var(--panel-2); border-bottom: 1px solid var(--line); flex-wrap: wrap; }

header.bar .title { font-weight: 800; letter-spacing: 0.5px; font-size: 14px; color: var(--text); margin-right: auto; text-transform: uppercase; }

header.bar .title span { color: var(--pink); }

button.btn { background: var(--panel); color: var(--text); border: 1px solid var(--line); padding: 4px 8px; border-radius: 10px; cursor: pointer; font-size: 14px; font-weight: 600; min-height: 40px; min-width: 40px; transition: transform 0.05s, background 0.15s, border-color 0.15s; }

button.btn:active { transform: translateY(1px); }

button.btn.run { background: var(--lime); color: rgb(10, 10, 10); border-color: var(--lime); }

button.btn.run:hover { filter: brightness(1.05); }

button.btn.stop { background: transparent; color: var(--pink); border-color: var(--pink); }

button.btn.ghost { background: transparent; }

button.btn.ghost:hover { border-color: var(--cyan); color: var(--cyan); }

.size-group { display: flex; align-items: center; gap: 6px; color: var(--muted); font-size: 13px; }

.size-group input { width: 64px; padding: 8px 6px; min-height: 40px; background: var(--bg); color: var(--text); border: 1px solid var(--line); border-radius: 8px; font-size: 14px; text-align: center; }

#stageWrap { flex: 1 1 0%; overflow: hidden; position: relative; background: radial-gradient(circle at 20% 10%, rgba(233,30,99,0.06), transparent 40%),
      radial-gradient(circle at 80% 90%, rgba(0,172,193,0.06), transparent 40%),
      var(--bg); }

#stage { position: absolute; inset: 0px; background: rgb(255, 255, 255); box-shadow: inset 0 0 0 1px var(--line); }

#app.mode-split #blocklyArea { flex: 1.2 1 0%; }

#app.mode-split #rightPanel { flex: 1 1 0%; }

#app.mode-max #blocklyArea { flex: 0 0 0px; min-width: 0px; display: none; }

#app.mode-max #rightPanel { flex: 1 1 0%; }

#app.mode-hidden #blocklyArea { flex: 1 1 0%; }

#app.mode-hidden #rightPanel { flex: 0 0 56px; min-width: 56px; }

#app.mode-hidden #stageWrap, #app.mode-hidden #log { bottom: 0px; left: 0px; right: 0px; z-index: 200; opacity: 0.92; display: none; position: absolute !important; }

#app.mode-hidden header.bar .title, #app.mode-hidden header.bar .run, #app.mode-hidden header.bar .stop { display: none; }

#app.mode-hidden header.bar { padding: 10px 6px; flex-direction: column; }

#stage canvas { position: absolute; top: 0px; left: 0px; display: block; }

#layerSPRITES { pointer-events: none; }

#dpad { position: absolute; bottom: 90px; left: 16px; display: grid; grid-template-columns: 50px 50px 50px; grid-template-rows: 50px 50px 50px; gap: 6px; z-index: 100; opacity: 0.95; touch-action: none; }

#dpad.hidden .dpad-btn { display: none; }

.dpad-btn { background: rgba(0, 0, 0, 0.55); color: rgb(255, 255, 255); border: none; border-radius: 10px; font-size: 20px; font-weight: 700; cursor: pointer; user-select: none; touch-action: none; display: flex; align-items: center; justify-content: center; }

.dpad-btn:active { background: var(--pink); }

.dpad-btn[data-key="up"] { grid-area: 1 / 2; }

.dpad-btn[data-key="left"] { grid-area: 2 / 1; }

.dpad-btn[data-key="down"] { grid-area: 2 / 2; }

.dpad-btn[data-key="right"] { grid-area: 2 / 3; }

.dpad-space { grid-area: 3 / 1 / auto / span 3; font-size: 13px !important; }

.dpad-toggle { position: absolute; bottom: 0px; right: -56px; width: 44px; height: 44px; background: rgba(0, 0, 0, 0.55); color: rgb(255, 255, 255); border: none; border-radius: 10px; font-size: 20px; cursor: pointer; }

.blocklyToolboxCategory { padding: 4px 0px !important; }

.blocklyTreeRow { min-height: 48px !important; padding: 0px 18px 0px 14px !important; margin: 6px 8px !important; border-radius: 10px !important; display: flex !important; align-items: center !important; }

.blocklyTreeLabel { font-size: 16px !important; font-weight: 700 !important; padding-left: 8px !important; }

.blocklyTreeIcon { width: 22px !important; height: 22px !important; }

.blocklyToolboxDiv { overflow: hidden auto !important; max-height: 100% !important; }

.blocklyTrash { opacity: 0.95; }

.blocklyTrash:hover { opacity: 1; }

#penCursor { position: absolute; left: 0px; top: 0px; width: 22px; height: 22px; margin-left: -11px; margin-top: -11px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace; font-size: 13px; font-weight: 700; pointer-events: none; user-select: none; z-index: 10; transition: transform 0.12s ease-out, background 0.15s, border-color 0.15s, box-shadow 0.15s; }

#penCursor[data-state="up"] { background: rgba(255, 255, 255, 0.92); color: rgb(136, 136, 136); border: 2px dashed rgb(136, 136, 136); box-shadow: rgba(0, 0, 0, 0.28) 0px 9px 14px -3px; }

#penCursor[data-state="down"] { background: var(--pink); color: rgb(255, 255, 255); border: 2px solid rgb(183, 22, 83); box-shadow: rgba(0, 0, 0, 0.35) 0px 1px 2px; }

#log { bottom: 0px; left: 0px; right: 0px; z-index: 200; opacity: 0.92; padding: 8px 14px; background: var(--panel-2); color: var(--muted); font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace; font-size: 12px; min-height: 32px; border-top: 1px solid var(--line); white-space: pre-wrap; max-height: 100px; overflow-y: auto; position: absolute !important; }

#log.ok { color: rgb(46, 125, 50); }

#log.err { color: var(--pink); }

.blocklyToolboxDiv { background: var(--panel-2) !important; border-right: 1px solid var(--line) !important; }

.blocklyTreeRow { padding: 6px 8px !important; }
